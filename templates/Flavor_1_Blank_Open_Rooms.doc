<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
  <meta charset='utf-8'>
  <title>CNA Shift Report Sheet Template</title>
  <style>
    @page WordSection1 { size: 11in 8.5in; margin: 0.25in; mso-page-orientation: landscape; }
    div.WordSection1 { page: WordSection1; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 8pt; color: #000; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    td, th { border: 1px solid #000; padding: 4px; text-align: left; }
    th { background: #000; color: #fff; font-weight: bold; text-transform: uppercase; font-size: 8pt; }
    .header-box { border: 2px solid #000; padding: 6px; margin-bottom: 8px; }
    .key-box { border: 1.5px solid #000; padding: 4px; margin-bottom: 8px; font-size: 7.5pt; }
    .badge { background: #000; color: #fff; padding: 1px 4px; font-weight: bold; }
    .card-table { width: 100%; border: 1.5px solid #000; margin-bottom: 6px; }
    .rm-badge { background: #000; color: #fff; font-weight: bold; font-size: 10pt; padding: 2px 6px; }
  </style>
</head>
<body>
<div class="WordSection1">

    <div class="header-box">
      <strong>FACILITY:</strong> Santé of Mesa | <strong>DATE:</strong> ____________ | <strong>SHIFT:</strong> [ ] DAY  [ ] EVE  [ ] NOC | <strong>CNA:</strong> ____________
    </div>
    <div class="key-box">
      <strong>DIETS:</strong> REG | MECH SOFT | MINCED & MOIST | PUREE | NPO &nbsp;|&nbsp; 
      <strong>LIQUIDS:</strong> THIN | NECTAR | HONEY | PUDDING &nbsp;|&nbsp; 
      <strong>BRIEF SIZES:</strong> M | L | XL | XXL | 3XL &nbsp;|&nbsp; 
      <strong>MEAL %:</strong> [ ]25% [ ]50% [ ]75% [ ]100%
    </div>
    <table>
      <tr>
        <th width="10%">RM #</th>
        <th width="20%">RESIDENT NAME</th>
        <th width="12%">CODE STATUS</th>
        <th width="18%">DIET & LIQUID</th>
        <th width="15%">TRANSFER / EQUIP</th>
        <th width="15%">BRIEF SIZE / TOILET</th>
        <th width="10%">MEAL %</th>
      </tr>
      <tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr><tr><td><strong>Rm ____</strong></td><td></td><td>FULL / DNR</td><td>REG / MOIST / THIN / HONEY</td><td>LIM / EXT / TOT</td><td>M / L / XL / XXL / 3XL</td><td>[ ]25% [ ]50% [ ]75% [ ]100%</td></tr>
    </table>
    </div></body></html>