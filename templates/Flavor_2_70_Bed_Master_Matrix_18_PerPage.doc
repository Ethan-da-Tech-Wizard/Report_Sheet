<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
  <meta charset='utf-8'>
  <title>CNA Shift Report Matrix Sheet Template</title>
  <style>
    @page WordSection1 { size: 11in 8.5in; margin: 0.25in; mso-page-orientation: landscape; }
    div.WordSection1 { page: WordSection1; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 7.5pt; color: #000; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 6px; }
    td, th { border: 1px solid #000; padding: 3px; text-align: left; vertical-align: top; }
    th { background: #000; color: #fff; font-weight: bold; text-transform: uppercase; font-size: 7.5pt; }
    .header-box { border: 2px solid #000; padding: 4px 8px; margin-bottom: 6px; font-size: 8pt; }
    .key-box { border: 1.5px solid #000; padding: 3px 6px; margin-bottom: 6px; font-size: 7pt; }
    .badge { background: #000; color: #fff; padding: 1px 3px; font-weight: bold; }
    .rm-num { font-weight: bold; font-size: 8.5pt; }
  </style>
</head>
<body>
<div class="WordSection1">

    <div class="header-box">
